# Environment Configuration
# Копируйте этот файл в .env и заполните своими значениями

# Путь к конфигурации (local.yaml для разработки, prod.yaml для продакшена)
CONFIG_PATH=config/local.yaml

# Bank API Credentials
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret

# Database
DATABASE_URL=postgres://user:password@localhost:5432/multibank?sslmode=disable

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key

# Logging
# 0=trace, 1=debug, 2=info, 3=warn, 4=error, 5=fatal
LOG_LEVEL=0
# "console" для разработки, "json" для продакшена
LOG_FORMAT=console

# VBank API Base URL
VBANK_BASE_URL=https://vbank.open.bankingapi.ru